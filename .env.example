# ===================================================================
# ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE - SAAS DE ARENAS
# Copie para .env antes de rodar ou configure no seu painel de deploy
# ===================================================================

# Chave secreta de produção (gere uma chave forte e única em produção)
SECRET_KEY=sua-chave-secreta-forte-aqui-gerada-com-django-secrets

# Modo Debug (False em produção obrigatório)
DEBUG=False

# Modo Demonstração (True para vitrine de portfólio com sandbox; False para produção real)
DEMO_MODE=True
DEMO_SECRET_TOKEN=

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=localhost,127.0.0.1,seusite.onrender.com,seusite.com.br

# Banco de Dados (deixe vazio para usar SQLite local ou informe PostgreSQL da nuvem)
# Exemplo PostgreSQL: postgresql://usuario:senha@host:5432/nomedobanco
DATABASE_URL=

# CORS e CSRF (separados por vírgula)
CORS_ALLOWED_ORIGINS=https://seusite-portfolio.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://seusite-portfolio.vercel.app,https://seusite.onrender.com,http://localhost:8000,http://localhost:3000

# Segurança de Cookies (True em produção com HTTPS)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Asaas - Pagamentos & Webhook
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# Mercado Pago (Opcional)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_APP_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_REDIRECT_URI=
MERCADO_PAGO_WEBHOOK_BASE=https://seusite.onrender.com

# E-mail (SMTP para envio de notificações / confirmações)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
